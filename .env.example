# ==============================================================================
# SkillGap M5 — Environment Configuration Example
# Copy to `.env` for local development. Never commit real secrets or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — Server Runtime
# ------------------------------------------------------------------------------

# Gemini API key used strictly server-side (src/server/geminiService.ts).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PostgreSQL / Cloud SQL connection credentials used at runtime (src/db/index.ts).
SQL_HOST="127.0.0.1"
SQL_USER="app_user"
SQL_PASSWORD="CHANGE_ME"
SQL_DB_NAME="skillgap_m5"

# ------------------------------------------------------------------------------
# REQUIRED FOR SCHEMA MIGRATIONS ONLY (drizzle-kit)
# ------------------------------------------------------------------------------

# Elevated PostgreSQL credentials used only by `src/db/drizzle.config.ts`.
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"

# ------------------------------------------------------------------------------
# OPTIONAL — Server, Frontend & Deployment
# ------------------------------------------------------------------------------

# Express server environment ("development" | "production"). Defaults to development.
NODE_ENV="development"

# HTTP listening port (defaults to 3000; Render/Cloud Run inject PORT automatically).
PORT="3000"

# Public hosted application URL (optional; used for links/deployment metadata).
APP_URL="http://localhost:3000"

# Optional frontend API base URL (client-side Vite env var, src/services/apiConfig.ts).
# Leave empty for unified hosting (local dev, Cloud Run, single-service Render).
# For split deployments (e.g. Vercel frontend + Render backend), set to backend origin
# without trailing slash, e.g. https://skillgap-m5.onrender.com
VITE_API_BASE_URL=""

# Optional Vite dev flag: set to "true" to disable HMR and file watching.
DISABLE_HMR="false"

# ------------------------------------------------------------------------------
# OPTIONAL — Permanent QA & Security Audit Admin Controls
# ------------------------------------------------------------------------------

# Comma-separated list of authorized admin email addresses for `/api/qa/*` endpoints.
# Defaults to the application owner account if left unset.
QA_ADMIN_EMAILS="admin@example.com"

# Optional automation API key (minimum 16 chars) for CI/CLI admin triggers via `X-QA-Admin-Key`.
# Leave empty unless invoking `/api/qa/*` from trusted automated pipelines.
QA_ADMIN_API_KEY=""
